# Wompi: usa production para dinero real o sandbox para pruebas
WOMPI_ENV=production

# Llave pública: pub_prod_... en producción / pub_test_... en sandbox
WOMPI_PUBLIC_KEY=

# Llave privada: NUNCA la pongas en HTML, JS del frontend o GitHub
WOMPI_PRIVATE_KEY=

# Secreto de integridad: prod_integrity_... / test_integrity_...
WOMPI_INTEGRITY_SECRET=

# Secreto para validar webhooks: prod_events_... / test_events_...
WOMPI_EVENTS_SECRET=

# URL pública donde corre tu app.
# En local déjalo así. Para producción usa https://tu-dominio...
APP_URL=http://localhost:3000

PORT=3000

# Gemini API — genera tu clave en Google AI Studio. Nunca la pongas en el frontend.
GEMINI_API_KEY=
# Modelo económico para el asistente. Puede cambiarse por otro modelo compatible.
GEMINI_MODEL=gemini-3.5-flash-lite
